 SG_ OilPressure : 32|8@1+ (0.05,0) [0|10] "bar" Dash

BO_ 512 VehicleSpeed: 8 ECU
 SG_ Speed : 7|16@0+ (0.01,0) [0|250] "km/h" Dash
 SG_ Gear : 23|4@0+ (1,0) [0|5] "" Dash
 SG_ SteeringAngle : 31|16@0- (0.1,0) [-540|540] "deg" Dash

BO_ 768 BatteryStatus: 8 BMS
 SG_ PackVoltage : 0|12@1+ (0.01,0) [0|40] "V" Dash
 SG_ PackCurrent : 16|16@1- (0.1,0) [-300|300] "A" Dash
 SG_ StateOfCharge : 32|7@1+ (1,0) [0|100] "%" Dash
 SG_ CellTempMax : 40|8@1- (1,0) [-40|80] "degC" Dash

BO_ 1024 BodyLights: 2 BCM
 SG_ Headlights : 0|1@1+ (1,0) [0|1] "" Dash
 SG_ LeftIndicator : 1|1@1+ (1,0) [0|1] "" Dash
 SG_ RightIndicator : 2|1@1+ (1,0) [0|1] "" Dash
 SG_ BrakeLight : 3|1@1+ (1,0) [0|1] "" Dash
